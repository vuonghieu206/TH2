<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyWebApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Learner" asp-action="Index">MyWebApp</a>
                <div class="navbar-nav">
                    <a class="nav-link text-white" asp-controller="Learner" asp-action="Index">Learner List</a>
                </div>
            </div>
        </nav>
    </header>
    <main class="container pb-4">
        @RenderBody()
    </main>
    <footer class="border-top footer text-muted mt-4 py-3">
        <div class="container">Bài thực hành 4 - Entity Framework Core .NET 10</div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
