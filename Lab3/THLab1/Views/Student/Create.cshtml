@model THLab1.Models.Student
@using THLab1.Models

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<h2>Thêm sinh viên</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Student" asp-action="Create" method="post">

    <div class="form-group row mt-3">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" placeholder="Nhập họ tên" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mt-3">
        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Email" class="form-control" placeholder="Nhập email Gmail" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mt-3">
        <label asp-for="Password" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mt-3">
        <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <select asp-for="Branch"
                    asp-items="Html.GetEnumSelectList<Branch>()"
                    class="form-control">
                <option value="">-- Chọn ngành học --</option>
            </select>
            <span asp-validation-for="Branch" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mt-3">
        <label asp-for="Gender" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            @foreach (var gender in Enum.GetValues<Gender>())
            {
                <label class="me-3">
                    <input type="radio" asp-for="Gender" value="@gender" />
                    @gender
                </label>
            }
            <br />
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mt-3">
        <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="IsRegular" class="form-check-input" />
            <span>Chính quy</span>
            <span asp-validation-for="IsRegular" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mt-3">
        <label asp-for="DateOfBirth" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="DateOfBirth" type="date" class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mt-3">
        <label asp-for="Address" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <textarea asp-for="Address" class="form-control"
                      placeholder="Nhập địa chỉ"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mt-3">
        <label asp-for="Score" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Score" type="number" step="any" min="0" max="10"
                   class="form-control" placeholder="Nhập điểm từ 0 đến 10" />
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mt-4">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">Thêm sinh viên</button>
            <a asp-controller="Student" asp-action="Index"
               class="btn btn-secondary">Quay lại</a>
        </div>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}