@model IEnumerable<THLab1.Models.Student>
@using THLab1.Models
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h2>QUẢN LÝ DANH SÁCH SINH VIÊN</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create Student
</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBirth.ToString("dd/MM/yyyy")</td>
                <td>
                    @(s.Branch switch
                    {
                        Branch.IT => "CNTT",
                        Branch.BE => "Kinh tế",
                        Branch.CE => "Công trình",
                        Branch.EE => "Điện - Điện tử",
                        _ => ""
                    })
                </td>
                <td>
                    @(s.Gender == Gender.Male ? "Nam" : "Nữ")
                </td>
                <td>
                    @(s.IsRegular ? "Chính quy" : "Phi chính quy")
                </td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>